{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": ["before 6am"],
  "minimumReleaseAge": "3 days",
  "argocd": {
    "managerFilePatterns": ["/^kubernetes-v2/argocd/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/",
      "/^kubernetes-v2/values/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchPackageNames": ["*"]
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["major-update"]
    },
    {
      "description": "Own images: deploy every release immediately",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/reidmason/**"],
      "groupName": null,
      "minimumReleaseAge": null,
      "schedule": ["at any time"],
      "automerge": true,
      "labels": []
    }
  ]
}
