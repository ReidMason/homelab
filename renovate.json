{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": ["every weekend"],
  "argocd": {
    "managerFilePatterns": ["/^kubernetes-v2/argocd/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["major-update"]
    }
  ]
}
